# Copy this file to .env and fill in real values. Same keys as the Streamlit app
# (studysage-rag/.env) - you can reuse the same providers/tokens here.

GROQ_API_KEY=
HF_API_TOKEN=
GEMINI_API_KEY=
DEEPSEEK_API_KEY=

# Secret used to sign JWT auth tokens - set this to a long random string in production.
JWT_SECRET=change-me-to-a-random-secret

# Where to store the SQLite DB, uploaded resumes, and the Chroma vector DB.
# Defaults to a local "data" folder next to this file if unset.
APP_DATA_DIR=

# Monetization - three tiers, each independently optional. Leave a tier's price ID blank to keep
# just that tier off (it 503s cleanly on click instead of the others breaking).
# Get these from your Stripe Dashboard once you're ready to actually turn a tier on:
#   STRIPE_SECRET_KEY: Developers -> API keys (use the sk_test_... key first, sk_live_... when ready)
#   STRIPE_PRICE_ID_SPRINT: Product catalog -> create a ONE-TIME "Career Sprint" price -> price ID
#   STRIPE_PRICE_ID_STUDENT: Product catalog -> create a ONE-TIME discounted "Student" price -> price ID
#   STRIPE_PRICE_ID_PRO_MONTHLY: Product catalog -> create a RECURRING monthly "Pro" price -> price ID
#   STRIPE_WEBHOOK_SECRET: Developers -> Webhooks -> add endpoint for POST /payments/webhook,
#     listening to checkout.session.completed AND customer.subscription.deleted -> signing secret
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRICE_ID_SPRINT=
STRIPE_PRICE_ID_STUDENT=
STRIPE_PRICE_ID_PRO_MONTHLY=
# Deployed frontend URL (or http://localhost:5173 for local dev) - Stripe redirects here after checkout.
FRONTEND_BASE_URL=http://localhost:5173
