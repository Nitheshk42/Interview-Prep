# Copy this file to .env and fill in real values. Same keys as the Streamlit app
# (studysage-rag/.env) - you can reuse the same providers/tokens here.

GROQ_API_KEY=
HF_API_TOKEN=
GEMINI_API_KEY=
DEEPSEEK_API_KEY=

# Secret used to sign JWT auth tokens - set this to a long random string in production.
JWT_SECRET=change-me-to-a-random-secret

# Where to store the SQLite DB, uploaded resumes, and the Chroma vector DB.
# Defaults to a local "data" folder next to this file if unset.
APP_DATA_DIR=
