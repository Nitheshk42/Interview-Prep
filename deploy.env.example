# Copy this file to deploy.env and fill in real values, then run ./deploy.sh
# deploy.env is gitignored - it never gets committed or pushed, so it's safe to put real
# secrets in it. This is exactly the same pattern as backend/.env for local dev.

PROJECT_ID="your-gcp-project-id"
REGION="us-central1"
DB_PASSWORD="pick-a-strong-password-here"          # Cloud SQL Postgres user password
JWT_SECRET="pick-a-long-random-string-here"         # signs auth tokens - do NOT reuse the local dev one

# Your LLM provider keys (same values as backend/.env). Blank ones are simply skipped as
# providers in the deployed app, same as running locally without them set.
GROQ_API_KEY=""
HF_API_TOKEN=""
GEMINI_API_KEY=""
DEEPSEEK_API_KEY=""
